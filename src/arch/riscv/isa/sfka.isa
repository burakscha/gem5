def format SfkMem(name, BaseISA) {{
    // 'Store' formatındaki SFK talimatları için genel bir şablon.
    // (SFK_SPILL ve gelecekteki SFK_KILL için kullanılacak)
    class {name}(BaseISA.MemWrite):
        __init__ = '''
            super().__init__()
            self.name = "{name}"
            self.className = "{name}"
        '''
        // Bu talimatın assembly'de nasıl görüneceğini tanımlar.
        // RISC-V S-formatına uygun: komut rs2, imm(rs1)
        disasm = '{{
            return f"{{self.name}} {{self.rs2_reg}}, {{self.imm_val}}({{self.rs1_reg}})"
        }}'

    // Bu şablonu kullanan bir talimatın tanımını yapar.
    defInst = '''
        {name} {{
            // Hata almamızı engelleyen en kritik blok.
            // MemWrite'dan miras aldığı için bu blok zorunludur.
            // Asıl işlevi C++'da doldurulacak.
            memacc_code = """
                // C++ execution code will be handled here later.
            """
        }};
    '''
}};

def format SfkLoad(name, BaseISA) {{
    // 'Load' formatındaki SFK talimatları için genel bir şablon.
    // (SFK_FILL için kullanılacak)
    class {name}(BaseISA.MemRead):
        __init__ = '''
            super().__init__()
            self.name = "{name}"
            self.className = "{name}"
        '''
        // Bu talimatın assembly'de nasıl görüneceğini tanımlar.
        // RISC-V I-formatına uygun: komut rd, imm(rs1)
        disasm = '{{
            return f"{{self.name}} {{self.rd_reg}}, {{self.imm_val}}({{self.rs1_reg}})"
        }}'

    defInst = '''
        {name} {{
            // Hata almamızı engelleyen en kritik blok.
            // MemRead'dan miras aldığı için bu blok zorunludur.
            memacc_code = """
                // C++ execution code will be handled here later.
            """
        }};
    '''
}};