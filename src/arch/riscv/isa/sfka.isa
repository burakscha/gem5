// SFK_SPILL: spill reg, [sfp+imm]
// This instruction uses the RISC-V S-Type format.
// We use CUSTOM_2 opcode (0x2B) and funct3 = 0x0.

def instruction SFK_SPILL : S_FORMAT_BASE_OP<"sfk_spill", 0x2B, 0x0>
{
    // Attributes for the instruction
    string op_name = "sfk_spill"; // A user-friendly name for debugging/tracing
    string c_name = "SFK_SPILL";  // C++ class name for this instruction

    // S_FORMAT_BASE_OP automatically provides the standard S-Type operands:
    // Rs1_sd: Base address register (we will use this for SFP)
    // Rs2_ud: Source register (value to spill)
    // IMM12:  12-bit signed immediate offset

    // Define the memory address calculation (Effective Address - EA)
    // EA = Base Register (Rs1) + immediate offset
    ea_code = {{ EA = rvSext(Rs1_sd + imm); }};

    // Mark it as a store-like operation. The custom logic will be in C++.
    mem_flags = [ IsStore ];

    // The actual C++ execution logic will go here. For now, it's a placeholder.
    execute = {{
        // In Step 2, this block will be modified to interact with the Spill Store
        // instead of the regular memory system.
        // DPRINTF(RiscvSFK, "SFK_SPILL: Spilling R%d to [R%d + 0x%x] (EA=0x%x)\n",
        //         Rs2, Rs1, (uint64_t)imm, (uint64_t)EA);
    }};

    // Define how the instruction should be displayed in traces (disassembly)
    // Ex: sfk_spill x5, -20(x2)  (where x2 is our SFP register)
    disassembly = "sfk_spill 'Rs2', 'imm'('Rs1')";
}