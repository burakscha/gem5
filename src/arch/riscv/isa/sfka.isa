def format SFK_SPILL(memacc_code, *opt_flags) {{
    # S-type instruction format kullan
    imm_code = """
        imm = sext<12>(IMM5 | (IMM7 << 5));
    """
    ea_code = """
        EA = Rs1 + imm;
    """
    
    (header_output, decoder_output, decode_block, exec_output) = \
        LoadStoreBase(name, Name, imm_code, ea_code, memacc_code, 
                      mem_flags=[], inst_flags=opt_flags, 
                      base_class='RiscvStaticInst', 
                      exec_template_base='Store')
}};

def format SFK_FILL(memacc_code, *opt_flags) {{
    # I-type instruction format kullan
    imm_code = """
        imm = sext<12>(IMM12);
    """
    ea_code = """
        EA = Rs1 + imm;
    """
    
    (header_output, decoder_output, decode_block, exec_output) = \
        LoadStoreBase(name, Name, imm_code, ea_code, memacc_code, 
                      mem_flags=[], inst_flags=opt_flags, 
                      base_class='RiscvStaticInst', 
                      exec_template_base='Load')
}};