# ── Simulation outputs ───────────────────────────────────────────────────────
m5out*/
benchmarks/*/m5out*/

# ── Log files ────────────────────────────────────────────────────────────────
*.log
*.out
*.err

# ── OMNeT++ simulation results ───────────────────────────────────────────────
*.sca
*.vec

# ── Benchmark input data (SPEC-licensed, not redistributable) ────────────────
benchmarks/perlbench/lib/
benchmarks/perlbench/rules/
benchmarks/perlbench/regen/
benchmarks/perlbench/t/
benchmarks/perlbench/*.pl
benchmarks/perlbench/*.pm
benchmarks/perlbench/*.rc
benchmarks/perlbench/*.in
benchmarks/povray/*.inc
benchmarks/povray/*.ttf
benchmarks/povray/*.pov
benchmarks/povray/*.tga
benchmarks/povray/*.ini
benchmarks/x264/*.yuv
benchmarks/x264/*.264
benchmarks/xz/*.xz
benchmarks/xz/*.tar.*
benchmarks/xalancbmk/*.xml
benchmarks/xalancbmk/*.xsl
# Fortran benchmarks: SPEC inputs copied from cpu2017/data (the binary and
# its stack PC map stay visible).
benchmarks/bwaves/*
!benchmarks/bwaves/*.riscv
!benchmarks/bwaves/*.stack_pc_map
benchmarks/exchange2/*
!benchmarks/exchange2/*.riscv
!benchmarks/exchange2/*.stack_pc_map
benchmarks/fotonik3d/*
!benchmarks/fotonik3d/*.riscv
!benchmarks/fotonik3d/*.stack_pc_map
benchmarks/roms/*
!benchmarks/roms/*.riscv
!benchmarks/roms/*.stack_pc_map
benchmarks/wrf/*
!benchmarks/wrf/*.riscv
!benchmarks/wrf/*.stack_pc_map
benchmarks/cam4/*
!benchmarks/cam4/*.riscv
!benchmarks/cam4/*.stack_pc_map
benchmarks/xalancbmk/*.xsd
benchmarks/lbm/*.of
benchmarks/lbm/*.in
benchmarks/namd/*.input
benchmarks/namd/*.output
benchmarks/cactuBSSN/*.par
benchmarks/imagick/*.tga
benchmarks/leela/*.sgf
benchmarks/deepsjeng/*.txt
benchmarks/blender/*.blend
benchmarks/blender/*.tga
benchmarks/mcf/*.in
benchmarks/nab/1am0/
benchmarks/parest/*.prm
benchmarks/parest/*.vtk
benchmarks/gcc/*.c
benchmarks/gcc/*.s
benchmarks/omnetpp/ned/
benchmarks/omnetpp/*.ini

