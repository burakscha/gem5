/1am0/
/aminos/
/gcn4dna/
/WORDS
/dictionary
/spec_train.par
/validate

# ── nab input data in benchmarks/nab/ ────────────────────────────────────────
benchmarks/nab/*.pdb
benchmarks/nab/*.prm
benchmarks/nab/aminos/
benchmarks/nab/gcn4dna/

# ── perlbench word lists ──────────────────────────────────────────────────────
benchmarks/perlbench/WORDS
benchmarks/perlbench/dictionary

# ── Build artefacts at repo root ─────────────────────────────────────────────
build_log*.txt
*.xl
hkrdenq
dataDec.txt
log
log.dec
mcf.out
me.prm
spec_test.par
statistics
test_python_link.c
*.vtk
frame_*.yuv
benchmarks/blender/blendcache_*/
benchmarks/lbm/report/
get-pip.py
Miniconda3-*.sh

# ── gem5-env (python venv) ───────────────────────────────────────────────────
gem5-env/

# ── util build logs ──────────────────────────────────────────────────────────
util/m5/m5_build_log.txt

# ── Test case compiled outputs (source .S files ARE tracked) ─────────────────
tests/spill_test/tc*/out/
tests/spill_test/tc*/out_*/
tests/spill_test/tc*/*.riscv
tests/spill_test/tc*/*.o
tests/spill_test/results/

# ── Python bytecode cache ────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── gem5 compiled build output (multi-GB) ────────────────────────────────────
build/
util/m5/build/
toolchain-shim/

# ── spill experiment housekeeping ────────────────────────────────────────────
# Batch launcher logs (the *.log rule above already covers these, kept for
# clarity now that they have a home).
logs/
# Installer leftovers that used to sit in the repository root.
Miniconda3-*.sh
get-pip.py
# LaTeX intermediates. The .tex sources and the compiled PDFs are both kept:
# the PDFs are the deliverables handed over for review.
general_reports/**/*.aux
general_reports/**/*.out
general_reports/**/*.synctex.gz

# Scratch directories blender creates in the working directory at run time.
blender_*/

# Per-input trees (2026-10-15): SPEC input copies and run outputs stay out of
# git; benchmarks/<bench>/<input>/report/ is meant to be tracked.
!benchmarks/*/test/
!benchmarks/*/train/
!benchmarks/*/ref/
benchmarks/*/*/inputs/
benchmarks/*/*/m5out/
